# Production Environment Variables
# This file is loaded during production build (npm run build & npm run preview)

# API Base URL - UPDATE THIS WITH YOUR ACTUAL BACKEND URL
# For testing preview locally, you can temporarily use: http://localhost:5000
# For actual deployment, use your deployed backend URL: https://your-backend-api.herokuapp.com
VITE_API_BASE_URL=http://localhost:5000

# Environment mode
VITE_NODE_ENV=production
