web: cd backend && python -c "import os; print(f'Current directory: {os.getcwd()}'); print(f'RENDER env var: {os.environ.get(\"RENDER\")}'); from app import app; from models import db; print(f'Database URI: {app.config[\"SQLALCHEMY_DATABASE_URI\"]}'); app.app_context().push(); db.create_all(); print('Database initialized successfully')" && gunicorn --bind 0.0.0.0:$PORT app:app --timeout 120
